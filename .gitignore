# OS-generated files
.DS_Store
Thumbs.db

# Editor directories and swap files
.idea/
*.swp
*.swo

# Keep shared VS Code settings opt-in, ignore other local state
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Logs and local temp files
*.log
*.tmp
*.temp

# Local environment files and secrets
.env
.env.*
!.env.example

# Generic caches
.cache/

# .NET build output
backend/bin/
backend/obj/
backend.Tests/bin/
backend.Tests/obj/
TestResults/

# Visual Studio solution-local cache and user-specific project settings
.vs/
*.user

# Stray cache from `dotnet run` file-based execution accidentally created at repo root
/dotnet/

# SvelteKit build output copied into backend/wwwroot at build time
backend/wwwroot/