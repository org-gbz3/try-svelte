{
  "ConnectionStrings": {
    "AuthDatabase": "Server=sqlserver,1433;Database=TrySvelte;User Id=sa;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Email": {
    // トークンの検証とメール本文の説明を揃えるための有効期限（分）。1以上の整数。
    "ConfirmationTokenLifespanMinutes": 1440,
    // パスワード再設定トークンの有効期限(分)。確認メールより高いリスクのため短めに設定する。1以上の整数。
    "PasswordResetTokenLifespanMinutes": 30,
    // 利用者がブラウザーで開く SPA の URL。開発時は http://localhost:5173、本番は HTTPS。
    "PublicBaseUrl": "http://localhost:5173",
    // Resend の SMTP ホスト名。
    "Host": "smtp.resend.com",
    // STARTTLS のポート（通常 587）。暗黙 TLS の 465 には対応しない。
    "Port": 587,
    // STARTTLS を有効にする。false は開発用メール受信サーバーでのみ使用する。
    "EnableSsl": true,
    // テスト用。宛先は Resend 登録メールのみ。他の宛先へ送る場合は検証済みドメインのアドレスへ変更する。
    "From": "onboarding@resend.dev",
    // Resend の SMTP 認証ユーザー名は固定値 resend。
    "Username": "resend",
    // Resend API キーを User Secrets の Email:Password または環境変数 Email__Password に設定する。
    // dotnet user-secrets set "Email:Password" "Resend API キー" --project backend
    "Password": ""
  },

  "Admin": {
    "Bootstrap": {
      // 最初の管理者アカウントのメールアドレス。空欄ならブートストラップしない(既に管理者が存在する場合も何もしない)。
      "Email": "",
      // パスワードは設定ファイルに直接書かず、User Secrets の Admin:Bootstrap:Password または
      // 環境変数 Admin__Bootstrap__Password に設定する。
      // dotnet user-secrets set "Admin:Bootstrap:Password" "初期パスワード" --project backend
      "Password": ""
    }
  }
}
